# Backend only. The browser and Vite never read this file.
# Copy to .env, put the key on the next line, and restart uvicorn.
GEMINI_API_KEY=

# Optional. Defaults are the documented Gemini Flash and Transcribe models.
# GEMINI_VISION_MODEL=gemini-3.8-flash
# GEMINI_STT_MODEL=gemini-3.5-transcribe
# GEMINI_TIMEOUT_SECONDS=30
# ASSISTANT_MAX_IMAGE_BYTES=8000000
# ASSISTANT_MAX_AUDIO_BYTES=8000000
# ASSISTANT_RATE_LIMIT=30
# ASSISTANT_RATE_WINDOW_SECONDS=60
# SYNCHRO_CAMERA_BRIDGE_URL=http://127.0.0.1:8765
