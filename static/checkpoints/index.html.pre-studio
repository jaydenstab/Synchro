<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>VisionGlove Studio — Offline Mock</title>
<style>
:root{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#eef2ff;background:#0b1020}*{box-sizing:border-box}body{margin:0;max-width:1050px;padding:32px 18px 55px;margin:auto}h1{margin:0;font-size:30px}p{line-height:1.6;color:#aebad1}.chip{display:inline-block;padding:5px 10px;background:#302321;color:#f1be95;border:1px solid #805a3c;border-radius:999px;font-size:12px}header{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;align-items:center;margin-bottom:23px}.grid{display:grid;grid-template-columns:1.3fr 1fr;gap:18px}.card{background:#151f34;border:1px solid #283752;border-radius:16px;padding:20px;margin-bottom:18px}h2{font-size:17px;margin:0 0 12px}canvas{width:100%;height:220px;border-radius:9px;background:#10182a}button{cursor:pointer;background:#507df5;color:white;border:0;border-radius:9px;padding:10px 13px;font-weight:700;margin:4px 3px 4px 0}button.alt{background:#283b60}button:disabled{opacity:.5}input,select{background:#0c1426;color:white;border:1px solid #405071;border-radius:9px;padding:11px;width:100%;margin:6px 0 12px}label{display:block;font-size:13px;color:#aebad1}.stat{font-family:ui-monospace,SFMono-Regular,monospace;white-space:pre-wrap;color:#d5f0d7;line-height:1.6;font-size:13px}.subtle{font-size:12px;color:#8fa1be}.footer{font-size:12px;color:#9faeca}@media(max-width:780px){.grid{grid-template-columns:1fr}}
</style></head>
<body><header><div><h1>VisionGlove Studio</h1><p>Hardware-free gesture recognition prototype</p></div><span class="chip">SYNTHETIC DATA — NOT REAL GLOVE</span></header>
<div class="grid"><div>
<section class="card"><h2>Live simulated MPU6050 feed</h2><p class="subtle">Blue = gx · Green = gy · Orange = gz · WebSocket synthetic stream</p><canvas id="plot" width="650" height="220"></canvas><div id="stream" class="subtle">Connecting…</div></section>
<section class="card"><h2>Train a custom gesture label</h2><p>This generates repeated synthetic motions for backend testing. It does not record your real hand.</p><label>Custom label</label><input id="label" value="my_new_gesture" maxlength="40"><label>Motion pattern to simulate</label><select id="motion"><option value="flick_right">Flick right</option><option value="flick_left">Flick left</option><option value="double_twist">Double twist</option><option value="circle">Circle</option></select><button onclick="addSamples()">Generate 10 examples</button><button onclick="train()" class="alt">Train DTW model</button><div id="training" class="stat">Model not initialized yet.</div></section>
</div><div>
<section class="card"><h2>Classify a new simulated movement</h2><p>Train a model first. Each button produces a fresh synthetic recording and requests a prediction.</p><div id="buttons"></div><div id="prediction" class="stat">No prediction yet.</div></section>
<section class="card"><h2>Dataset status</h2><div id="status" class="stat">Loading…</div></section>
<section class="card"><h2>Integration contract</h2><p>POST <code>/api/recordings</code> with a gesture label and samples containing <code>t_ms,ax,ay,az,gx,gy,gz</code>. This same API will accept recordings from the actual glove.</p><p class="subtle">Conventions: acceleration in m/s²; gyro in rad/s; sample timestamps strictly increasing. Current model is a demo baseline and thresholds require calibration on real data.</p></section>
</div></div><p class="footer">Synthetic streams are useful for interface and algorithm integration, not validation of real sensor performance.</p>
<script>
const $=id=>document.getElementById(id);const pretty=x=>JSON.stringify(x,null,2);
async function request(url,options={}){const r=await fetch(url,options);let obj=await r.json();if(!r.ok)throw new Error(pretty(obj));return obj}
const post=(url,body)=>request(url,{method:'POST',headers:{'content-type':'application/json'},...(body!==undefined?{body:JSON.stringify(body)}:{})});
async function update(){const s=await request('/api/status');$('status').textContent=pretty(s)}
async function addSamples(){try{const x=await post('/api/demo/generate',{label:$('label').value.trim(),motion:$('motion').value,examples:10});$('training').textContent=pretty(x);await update()}catch(e){$('training').textContent=e.message}}
async function train(){try{$('training').textContent=pretty(await post('/api/train'));await update()}catch(e){$('training').textContent=e.message}}
async function testMotion(kind){try{$('prediction').textContent=pretty(await post(`/api/demo/predict/${kind}`))}catch(e){$('prediction').textContent=e.message}}
['flick_right','flick_left','double_twist','circle','idle','unknown'].forEach(k=>{let b=document.createElement('button');b.textContent=k.replaceAll('_',' ');b.className='alt';b.onclick=()=>testMotion(k);$('buttons').append(b)});
const canvas=$('plot'),ctx=canvas.getContext('2d');let buf=[];function draw(){ctx.clearRect(0,0,650,220);ctx.strokeStyle='#293652';for(let y=20;y<220;y+=40){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(650,y);ctx.stroke()};const colors=['#6ea2ff','#69dbb0','#ffba77'];['gx','gy','gz'].forEach((k,j)=>{ctx.strokeStyle=colors[j];ctx.lineWidth=2;ctx.beginPath();buf.forEach((v,i)=>{const x=i*650/150,y=110-v[k]*35;i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.stroke()})}
function connect(){let ws=new WebSocket(`${location.protocol==='https:'?'wss':'ws'}://${location.host}/ws/telemetry`);ws.onmessage=e=>{const m=JSON.parse(e.data);buf.push(m.sample);if(buf.length>150)buf.shift();$('stream').textContent=`Source: ${m.source} · Simulating: ${m.motion}`;draw()};ws.onclose=()=>{$('stream').textContent='Disconnected. Reload to retry.'}}
connect();update().catch(e=>$('status').textContent=e.message);
</script></body></html>
